# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_blocks_v3

# 模型
EMBEDDING_MODEL_PATH=/Users/leo/ai/models/bge-m3
RERANKER_MODEL_PATH=/Users/leo/ai/models/bge-reranker-v2-m3

# 分块与上传
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_TOKENS=60
UPLOAD_DIR=data/uploads

# 解析：扫描件多，OCR 默认开
OCR_ENABLED=true

# VLM 图片描述：默认本地 SmolVLM；填 URL 则走 API（与 BGE 一样建议本地目录管理）
VLM_ENABLED=true
VLM_MODEL_ID=/Users/leo/ai/models/SmolVLM-256M-Instruct
VLM_ENDPOINT=

# 对外图片 URL 前缀（/search 直接返完整 URL；留空则返相对路径）
PUBLIC_BASE_URL=http://localhost:8000
